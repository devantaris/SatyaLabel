# ── SatyaLabel production environment ────────────────────────────────────────
# Copy to .env.prod and fill in every value marked CHANGE-ME.
# Never commit .env.prod.

# ── Security (CHANGE-ME) ────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32

# Postgres password for the db service (CHANGE-ME)
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password

# ── CORS: comma-separated list of allowed frontend origins ──────────────────
ALLOWED_ORIGINS=["https://satyalabel.yourdomain.in"]

# ── Auth ────────────────────────────────────────────────────────────────────
# First-admin bootstrap: set once, register the admin, then remove.
# BOOTSTRAP_ADMIN_EMAIL=admin@gov.in
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-bootstrap-password

# ── Optional: S3 image storage (instead of the shared volume) ────────────────
# STORAGE_BACKEND=s3
# S3_BUCKET=satyalabel-evidence
# S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# S3_PUBLIC_URL_BASE=https://satyalabel-evidence.s3.ap-south-1.amazonaws.com
# AWS credentials come from the standard boto3 chain (env/IAM role).
