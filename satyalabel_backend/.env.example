# ── General ────────────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://satyalabel:satyalabel@localhost:5432/satyalabel
DATABASE_URL_SYNC=postgresql+psycopg2://satyalabel:satyalabel@localhost:5432/satyalabel

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── OCR ────────────────────────────────────────────────────────────────────────
# Windows: set full path to tesseract.exe
# Linux/macOS: /usr/bin/tesseract  (usually on PATH, can omit)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_CONFIDENCE_THRESHOLD=0.60
OCR_FALLBACK_THRESHOLD=0.40

# ── File Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
